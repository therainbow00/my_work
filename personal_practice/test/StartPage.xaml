<UserControl x:Class="test.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:test"
             mc:Ignorable="d" Width="800" Height="450">
	<Grid>
		<TextBox x:Name="searchButton" HorizontalAlignment="Stretch" Margin="0,134,0,0" TextWrapping="Wrap" Text="Search" VerticalAlignment="Top" TextAlignment="Center" FontSize="48" Width="346" BorderBrush="{x:Null}"/>
		<Button x:Name="_Computer" Content="Computer" HorizontalAlignment="Left" Click="ComputerSearch" FontSize="16" Height="57" Width="262" Foreground="Red" FontWeight="Bold" Margin="33,304,0,89"/>
		<Button x:Name="Non_Computer" Content="NonComputer" FontSize="16" Height="57" Width="262" Foreground="Red" FontWeight="Bold" Margin="494,304,44,89"/>
	</Grid>
</UserControl>
