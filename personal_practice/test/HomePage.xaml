<UserControl x:Class="test.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:test"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid>
		<TextBox HorizontalAlignment="Left" Text="Device Name" FontSize="18" TextAlignment="Center" TextWrapping="WrapWithOverflow" BorderBrush="{x:Null}" Background="Black" Foreground="White" Margin="51,268,0,136" Width="187"/>
		<TextBox HorizontalAlignment="Left" Text="Make" FontSize="18" TextAlignment="Center" TextWrapping="WrapWithOverflow" BorderBrush="{x:Null}" Background="Black" Foreground="White" Margin="163,362,0,42" Width="150" TextChanged="TextBox_TextChanged"/>
		<TextBox HorizontalAlignment="Left" Text="Model" FontSize="18" TextAlignment="Center" TextWrapping="WrapWithOverflow" BorderBrush="{x:Null}" Background="Black" Foreground="White" Margin="549,266,0,135" Width="171"/>
		<TextBox Text="Serial Number" TextAlignment="Center" TextWrapping="WrapWithOverflow" BorderBrush="{x:Null}" Background="Black" Foreground="White" Margin="292,266,338,138" FontSize="17"/>
		<TextBox HorizontalAlignment="Left" Text="Purchase Date" FontSize="18" TextAlignment="Center" TextWrapping="WrapWithOverflow" BorderBrush="{x:Null}" Background="Black" Foreground="White" Margin="476,362,0,42" Width="170"/>
		<DataGrid x:Name="Inventory" Margin="0,0,0,203" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" CanUserReorderColumns="False" CanUserDeleteRows="False" CanUserAddRows="False">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Device Name" Binding="{Binding deviceName}"/>
				<DataGridTextColumn Header="Make" Binding="{Binding Make}"/>
				<DataGridTextColumn Header="Model" Binding="{Binding Model}"/>
				<DataGridTextColumn Header="Serial Number" Binding="{Binding serialNumber}"/>
				<DataGridTextColumn Header="Perchase Date" Binding="{Binding purchaseDate}"/>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>
