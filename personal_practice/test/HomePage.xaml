<UserControl x:Class="test.HomePage"
			 Loaded="ChooseOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:test"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
			 MinHeight="50" MinWidth="50">
	<UserControl.Resources>
		<Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
			<DoubleAnimation Storyboard.TargetName="StatusLight" Storyboard.TargetProperty="Width" From="12" To="18" Duration="0:0:0.6" />
			<DoubleAnimation Storyboard.TargetName="StatusLight" Storyboard.TargetProperty="Height" From="12" To="18" Duration="0:0:0.6" />
		</Storyboard>
	</UserControl.Resources>
	<DockPanel x:Name="RootDock">
		<Border x:Name="SearchPanel"
			Background="LightGray"
			Width="220"
			Padding="10"
			Visibility="Collapsed"
			DockPanel.Dock="Left"
			BorderBrush="Gray"
			BorderThickness="0,0,5,0">
			<StackPanel>
				<TextBlock Text="Device Name:" Margin="0,0,0,5"/>
				<TextBox Width="150" Height="25" Name="DeviceName"/>

				<TextBlock Text="Make:" Margin="0,10,0,5"/>
				<TextBox Width="150" Height="25" Name="Make"/>

				<TextBlock Text="Model:" Margin="0,10,0,5"/>
				<TextBox Width="150" Height="25" Name="Model"/>

				<TextBlock Text="Serial Number:" Margin="0,10,0,5"/>
				<TextBox Width="150" Height="25" Name="SerialNumber"/>

				<TextBlock Text="Perchase Date From:" Margin="0,10,0,5"/>
				<DatePicker Width="150" Height="25" Name="PurchaseDate" SelectedDateFormat="Short"/>

				<TextBlock Text="Perchase Date To:" Margin="0,10,0,5"/>
				<DatePicker Width="150" Height="25" Name="PurchaseDateTo"/>

				<Button Content="Submit" Width="100" Margin="0,10,0,0" Click="SubmitSearch_Click"/>
			</StackPanel>
		</Border>
		<Grid>
			<Button x:Name="Search"
					Content="Search"
					HorizontalAlignment="Left"
					VerticalAlignment="Top"
					Margin="374,269,374,208"
					Height="20"
					Width="45"
					Click="ToggleSearch_Click"/>
			<DataGrid x:Name="Inventory"
					  VerticalScrollBarVisibility="Visible" 
					  HorizontalScrollBarVisibility="Visible"
					  CanUserReorderColumns="False" 
					  CanUserDeleteRows="False"
					  CanUserAddRows="False"
					  MaxHeight="300" 
					  MaxWidth="750"
					  MinWidth="10"
					  MinHeight="10"
					  Margin="28,10,28,259" 
					  AutoGenerateColumns="False">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Device Name" Binding="{Binding deviceName}" Width="*"/>
					<DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="*"/>
					<DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
					<DataGridTextColumn Header="Serial Number" Binding="{Binding serialNumber}" Width="*"/>
					<DataGridTextColumn Header="Perchase Date" Binding="{Binding perchaseDate}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
			<Border x:Name="StatusPanel"
				 Background="Transparent"
				 Padding="6"
				 CornerRadius="6"
				 HorizontalAlignment="Left"
				 VerticalAlignment="Bottom"
				 Margin="10"
				 BorderBrush="Transparent"
				ToolTip="Database Connection Status">
			 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
					<Ellipse x:Name="StatusLight" Width="12" Height="12" Fill="Gray" Margin="0,0,10,0"/>
					<TextBlock x:Name="StatusText" Text="Disconnected" FontWeight="Bold" VerticalAlignment="Center"/>
			 </StackPanel>
				<!--<Ellipse x:Name="StatusLight"
					 MaxHeight="50"
					 MaxWidth="50"
					 Margin="-6,458,744,0"/>
			<TextBlock x:Name="StatusText"
					   Margin="65,477,663,0"
					   Text="Database"
					   TextAlignment="Center"/>-->
				<!--!<Menu Margin="374,269,374,208" MaxHeight="50" MaxWidth="50">
				<MenuItem Header="Search">-->
				<!--</MenuItem>-->
				<!--!</Menu>-->
			</Border>
		</Grid>
	</DockPanel>
</UserControl>
