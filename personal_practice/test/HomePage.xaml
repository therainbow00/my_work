<UserControl x:Class="test.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:test"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
	<Grid>
		<DataGrid x:Name="Inventory" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" CanUserReorderColumns="False" CanUserDeleteRows="False" CanUserAddRows="False" MaxHeight="800" MinWidth="10" MinHeight="10" Margin="0,0,0,255" AutoGenerateColumns="False">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Device Name" Binding="{Binding deviceName}" Width="*"/>
				<DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="*"/>
				<DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
				<DataGridTextColumn Header="Serial Number" Binding="{Binding serialNumber}" Width="*"/>
				<DataGridTextColumn Header="Purchase Date" Binding="{Binding purchaseDate}" Width="*"/>
			</DataGrid.Columns>
		</DataGrid>
		<TextBox HorizontalAlignment="Left" Margin="75,345,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" Height="32" MinHeight="20" MinWidth="115" TextAlignment="Center" Background="Black" Foreground="White"/>
		<TextBox HorizontalAlignment="Left" Margin="555,345,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" MinHeight="20" MinWidth="115"/>
		<Menu Margin="374,269,374,208" VerticalAlignment="Stretch">
			<MenuItem Header="Search">
				<StackPanel>
					<TextBlock Text="Device Name:" Margin="0,0,0,5"/>
					<TextBox Width="150" Height="25" Name="DeviceName"/>

					<TextBlock Text="Make:" Margin="0,10,0,5"/>
					<TextBox Width="150" Height="25" Name="Make"/>

					<TextBlock Text="Model:" Margin="0,10,0,5"/>
					<TextBox Width="150" Height="25" Name="Model"/>

					<TextBlock Text="Serial Number:" Margin="0,10,0,5"/>
					<TextBox Width="150" Height="25" Name="SerialNumber"/>

					<TextBlock Text="Perchase Date:" Margin="0,10,0,5"/>
					<DatePicker Width="150" Height="25" Name="PurchaseDate" SelectedDateFormat="Short"/>

					<Button Content="Submit" Width="100" Margin="0,10,0,0" Click="SubmitSearch_Click"/>
				</StackPanel>
			</MenuItem>
		</Menu>
	</Grid>
</UserControl>
